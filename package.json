{
  "name": "@sytadel/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing Sytadel identity + access primitives as tools consumable from Claude Desktop, Cursor, and any MCP client.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sytadel-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/tools.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
